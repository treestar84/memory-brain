{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bun run bin/cfgm-ssl-status.ts --json"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bun run bin/cfgm-ssl-status.ts --json"
          }
        ]
      }
    ]
  },
  "theme": "dark",
  "$schema-comment": "Claude Code settings for memory-brain PAI session. 본 파일은 .claude-pai/ 프로파일 안에서만 활성화된다. 사용자 메인 .claude/settings.json 에 영향 없음."
}
